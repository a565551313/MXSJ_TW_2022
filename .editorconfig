# 编辑器统一设置（VS Code / PyCharm 等自动读取）。约定见 docs/PYTHON_TOOL_CONVENTIONS.md。
root = true

[*.py]
charset = utf-8
indent_style = space
indent_size = 4
max_line_length = 88
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.{md,toml,json,yml,yaml}]
charset = utf-8
insert_final_newline = true
