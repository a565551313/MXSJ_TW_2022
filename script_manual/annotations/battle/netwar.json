  "modification_guides": [
    {
      "question": "战斗开始链路在哪里？",
      "answer": {
        "text": "S2CWarStart 解析场景/布阵/类型/坐标/背景/版本/回合，切换 main 主循环为战斗循环（main.SetWarLoop），创建 Start 指令并入队。",
        "confidence": "extracted",
        "evidence": [
          "start"
        ]
      }
    },
    {
      "question": "战斗结束链路在哪里？",
      "answer": {
        "text": "S2CWarEnd 递减战斗次数，构造 End 指令，恢复地图视图与网络缓存。",
        "confidence": "extracted",
        "evidence": [
          "end"
        ]
      }
    },
    {
      "question": "新回合如何处理？",
      "answer": {
        "text": "S2CWarTurn 存储上回合状态，构造 Turn 指令，递增回合计数。",
        "confidence": "extracted",
        "evidence": [
          "turn"
        ]
      }
    },
    {
      "question": "想修改战斗网络消息字段？",
      "answer": {
        "text": "在对应 S2C*/C2S* 函数中调整 UnpackInt/PacketAddI 的类型与长度；协议号在 net 模块。",
        "confidence": "inferred",
        "evidence": [
          "c2s",
          "start"
        ]
      }
    },
    {
      "question": "战斗主循环切换链路（协审 main.py）在哪里？",
      "answer": {
        "text": "S2CWarStart 调用 main.SetWarLoop() 将主循环切为战斗循环，并 war.SetProcess(war.NextCmd)；S2CWarEnd 后需恢复非战斗循环。本意见供 C/A 在 main.py 正文统一，F 不重复建档 main.py。",
        "confidence": "static_reviewed",
        "evidence": [
          "start",
          "end"
        ]
      }
    }
  ],
