          "dlgitem_ShowDlg",
          "dlgitem_ShowSwitch",
          "dlgitem_PreShowDlgAfterLogin"
        ]
      }
    },
    {
      "question": "整理、物品锁、右键使用和Shift复制分别改哪里？",
      "answer": {
        "text": "整理网络动作是OnMessage的4号，本地排序窗是15号；5/7号是物品加解锁入口，1号另调OpenLock。右键UseItem有手持和召唤兽门禁，左键SelectItem按Shift转复制或Take。改发送/使用规则须跟nethero/netplayer/item委托并联调，不能只改按钮文字。",
        "confidence": "static_reviewed",
        "evidence": [
          "dlgitem_CItemDialog_OnMessage",
          "dlgitem_CItemDialog_UseItem",
          "dlgitem_CItemDialog_SelectItem",
          "dlgitem_ShowItemSortDlg"
        ]
      }
    },
