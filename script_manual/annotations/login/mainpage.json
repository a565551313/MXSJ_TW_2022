  "modification_guides": [
    {
      "question": "刷新公告失败在哪里触发？",
      "answer": {
        "text": "refreshbulletin：HTTP失败(succeed=False)或响应缺少\\r\\n\\r\\n头分隔符时弹“刷新公告失敗”；网络/URL问题需日志与抓包验证。",
        "confidence": "static_reviewed",
        "evidence": [
          "refresh"
        ]
      }
    },
    {
      "question": "修改公告正文、地址、布局分别在哪里？",
      "answer": {
        "text": "正文：news.txt（刷新成功覆盖，失败缓存g_News）；地址：update.ini的Setting/HK的News与Service；布局：login/mainpage.dlg；触发：OnMessage(30)与Show的自动刷新。",
        "confidence": "static_reviewed",
        "evidence": [
          "cls",
          "messages",
          "refresh",
          "show"
        ]
      }
    },
    {
      "question": "登录按钮点击后经过哪些函数和模块？",
      "answer": {
        "text": "OnMessage(1)隐藏首页并调用selectserver.Show(True)；非TW注册入口OnMessage(2)调用register.Show(True)；登录提交链在loginin/OnLogin与netserver/netlogin，需E/F协审。",
        "confidence": "static_reviewed",
        "evidence": [
          "messages"
        ]
      }
    },
    {
      "question": "注册逻辑与布局分别在哪里？",
      "answer": {
        "text": "逻辑在script/login/register.py（entry 4007），布局login/reg*.dlg/confirm.dlg；首页仅负责入口切换。",
        "confidence": "static_reviewed",
        "evidence": [
          "messages"
        ]
      }
    }
