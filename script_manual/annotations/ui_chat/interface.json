  "modification_guides": [
    {
      "question": "界面公共基础和具体业务界面的边界是什么？",
      "answer": {
        "text": "本文件管输入、点击、捕获、拖动、基础控件、样式资源的共同机制；mainmenu管主界面组合，combtnmenu/delegatebtnmenu管菜单业务，chatinput.CChatInput重写输入发送，chatoutput管输出。要改某个按钮/发送规则优先到业务模块，不在公共LeftUp或CEdit.MsgEnter里硬编码业务。",
        "confidence": "static_reviewed",
        "evidence": [
          "if_message_process",
          "if_click",
          "if_edit_base_commands",
          "menu_construct",
          "support_chatinput_send"
        ]
      }
    },
    {
      "question": "按钮点击没反应/触发错功能，检查哪里？",
      "answer": {
        "text": "先核实际控件类与签名：CClickBox(parent,w,h,color=0,alpha=256,msgid=0)不是图片按钮签名。再查Enable登记、非零msgid优先于左键回调、GetUIRootNode弱引用、接收者OnMessage与右键大偏移。本轮仅静态核对，不能用桩件成功替代实机。",
        "confidence": "static_reviewed",
        "evidence": [
          "if_click",
          "if_enable",
          "if_default_button"
        ]
      }
    },
    {
      "question": "修改正文、URL、布局、图片或字体，入口分别是什么？",
      "answer": {
        "text": "interface没有统一业务正文/URL；到具体业务的文本、链接构造处查。通用布局只看到sUIName→combdialog.GetUIInfo，具体.dlg由子类/组件给出。图片查GetInitPath/UIPath与style，字体/颜色查InitStyle的数据来源。未检查目标包内容，不能保证某字体常量或图片存在，也不应靠改GCODE掩盖解码错误。",
        "confidence": "static_reviewed",
        "evidence": [
          "if_exports",
          "if_style",
          "if_dialog",
          "if_resource_path"
        ]
      }
    },
    {
      "question": "快捷键与文字输入冲突，应改哪条链？",
      "answer": {
        "text": "组合键登记/条件/回调查key.RegisterHotKey和CFunctor；文本/IME/编辑命令查interface.CharInput与CEdit.CharInput，聊天发送再到chatinput子类。native两条回调的先后、焦点状态、空格占用和Alt/Ctrl应实机分别回归；本稿不承诺统一事件顺序。",
        "confidence": "static_reviewed",
        "evidence": [
          "if_character_route",
          "if_edit_char",
          "key_functor_call",
          "key_functor_set",
          "support_chatinput_send"
        ]
      }
    }
  ],
